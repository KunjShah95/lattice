# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare Workers / OpenNext build output
/.open-next/
/.wrangler/
/worker-configuration.d.ts

# local verification screenshots
/shots

# rendered Open Graph cards (scripts/render-og.mjs output)
/og-out

# vitest cache dir, written by `--reporter=json --outputFile=...`
/.vitest

# local server logs
/server.log
/server.err
