# Project-scoped install-script allowlist.
# npm 11 blocks lifecycle scripts by default; this stack pulls a few
# native binaries that need theirs. Global ~/.npmrc is left untouched.
# Format is bare comma-separated package names (no JSON brackets/quotes).
allow-scripts=@tailwindcss/oxide,sharp,unrs-resolver,@next/swc-win32-x64-msvc,@next/swc-win32-gnu-msvc
