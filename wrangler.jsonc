{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "lattice",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve public/*.html at the exact path requested. The default
    // ("auto-trailing-slash") 307s /foo.html to /foo, which breaks search
    // engine verification files — Google requires the file at its own URL,
    // with no redirect. Pages are rendered by the Worker, not served from
    // this directory, so nothing else is affected.
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }

  // Deliberately minimal. The stock @opennextjs/cloudflare template also
  // declares a WORKER_SELF_REFERENCE service binding, an R2 incremental-cache
  // bucket and an IMAGES binding. None of them apply here:
  //
  //   - no ISR or `revalidate` anywhere, so there is nothing to revalidate and
  //     no reason to require an R2 bucket to exist before the first deploy;
  //   - no `next/image`, so Next's image optimizer never runs;
  //   - every opengraph-image is prerendered (lib/og.tsx reads its fonts from
  //     disk, which the Worker does not have — an on-demand card is a 500);
  //     only /feed.xml, /llms.txt and /llms-full.txt are dynamic, which is
  //     why this deploys as a Worker rather than a static export.
  //
  // Add the bindings back deliberately if ISR or image optimization arrives.
}
