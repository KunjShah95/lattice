# Copy to .env.local and fill in. Everything here is read at build time.
#
# `brand.test.ts` fails the suite while any of these is still a placeholder.
# That is deliberate: a placeholder domain does not break the build, it
# publishes hundreds of correct-looking pages whose canonicals, og:urls and
# share images all point somewhere nobody owns.

# Your production origin. No trailing slash.
# Must be https, must be a domain you control.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Shown in the footer and in Article JSON-LD.
NEXT_PUBLIC_COPYRIGHT_HOLDER=Your Name

NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_CONTACT_X=https://x.com/yourhandle

# Optional: named byline on essays and comparisons (organisation attribution if unset).
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_AUTHOR_URL=https://your-domain.com/about

# Public GitHub repo for issues (contact page and corrections). Optional fork override.
NEXT_PUBLIC_REPO_URL=https://github.com/your-org/your-repo