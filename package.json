{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "next:build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run next:build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "deploy": "npm run build && npm run cf:deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.7",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@tailwindcss/oxide": true,
    "sharp": true,
    "@next/swc-win32-x64-msvc": true,
    "@next/swc-win32-gnu-msvc": true,
    "@next/swc-linux-x64-gnu": true,
    "@next/swc-linux-x64-musl": true,
    "@next/swc-darwin-x64": true,
    "@next/swc-darwin-arm64": true,
    "esbuild": true,
    "workerd": true
  }
}
